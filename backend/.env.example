# Copia este archivo como .env y completa con tus valores reales.
# NUNCA subas el .env al repo (ya está en .gitignore).

# Puerto de la API
PORT=4000

# === Conexión a PostgreSQL ===
# OPCIÓN A (nube: Neon/Supabase/Render): descomenta y pega tu URL completa.
# DATABASE_URL=postgresql://usuario:password@host/basededatos

# OPCIÓN B (local): usa estas variables (deja DATABASE_URL comentada).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=stockpro
DB_USER=postgres
DB_PASSWORD=tu_password

# Secreto para firmar los JWT (usa una cadena larga y aleatoria)
JWT_SECRET=cambia_esto_por_algo_muy_largo_y_secreto
JWT_EXPIRES=8h

# Origen permitido para CORS (tu frontend en desarrollo)
CORS_ORIGIN=http://localhost:5173
